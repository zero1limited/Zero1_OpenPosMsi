<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="openpos_msi_source_deduction" resource="default" engine="innodb" comment="Zero1_OpenPosMsi stock deducted from sources for till sales">
        <column xsi:type="int" name="deduction_id" unsigned="true" nullable="false" identity="true" comment="Deduction ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" identity="false" comment="Magento sales_order ID"/>
        <column xsi:type="int" name="order_item_id" unsigned="true" nullable="false" identity="false" comment="Magento sales_order_item ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="varchar" name="source_code" length="255" nullable="true" comment="Source deducted from"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" unsigned="false" nullable="false" default="0" comment="Quantity sold"/>
        <column xsi:type="decimal" name="qty_deducted" scale="4" precision="12" unsigned="false" nullable="false" default="0" comment="Quantity deducted from the source"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="deduction_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENPOS_MSI_SOURCE_DEDUCTION_ORDER_ID_SALES_ORDER_ENTITY_ID"
            table="openpos_msi_source_deduction" column="order_id"
            referenceTable="sales_order" referenceColumn="entity_id"
            onDelete="CASCADE"/>
        <index referenceId="OPENPOS_MSI_SOURCE_DEDUCTION_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
</schema>
