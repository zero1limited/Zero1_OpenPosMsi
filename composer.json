{
    "name": "zero1/open-pos-msi",
    "description": "Magento Inventory (MSI) support for OpenPOS",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "magento/framework": "^103.0",
        "magento/module-inventory-api": "^1.2",
        "magento/module-inventory-catalog-api": "^1.3",
        "magento/module-inventory-configuration-api": "^1.2",
        "magento/module-inventory-sales": "^1.3",
        "magento/module-inventory-sales-api": "^1.2",
        "magento/module-inventory-source-deduction-api": "^1.2",
        "zero1/open-pos": "^2.4.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero1\\OpenPosMsi\\": ""
        }
    },
    "keywords": [
        "Magento 2",
        "Magento"
    ],
    "support": {
        "source": "https://github.com/zero1limited/Zero1_OpenPosMsi.git"
    }
}
